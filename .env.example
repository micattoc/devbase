# Required: Hugging Face token used by LightRAG for LLM and embedding calls.
HF_TOKEN=

# Modifiable: Hugging Face models/provider.
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_PROVIDER=auto

# Optional: GitHub token for private repos or higher API rate limits.
GITHUB_TOKEN=

# Optional: Braintrust only logs eval results when this key is set.
BRAINTRUST_API_KEY=

# LightRAG storage folders.
LIGHTRAG_LIVE_DIR=./storage/live
LIGHTRAG_STAGING_DIR=./storage/staging
LIGHTRAG_BACKUP_DIR=./storage/live_backup

# n8n production webhook and local setup status file.
N8N_QUALITY_GATE_WEBHOOK_URL=http://localhost:5678/webhook/kb-updated
N8N_SETUP_STATUS_PATH=./.devbase/n8n_setup.json

# local operational files.
AUDIT_LOG_PATH=./audit.jsonl
INGESTION_MANIFEST_PATH=./ingestion_manifest.json
